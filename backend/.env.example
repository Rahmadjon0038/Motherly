PORT=5100
DATABASE_URL=postgresql://postgres@localhost:5432/qrcode_db
JWT_SECRET=change-me
DEV_SMS_CODE=1111

# Super admin (ixtiyoriy). Berilmasa parol tasodifiy yaratiladi, server logida chiqadi
# va private/admin-credentials.json da saqlanadi.
#ADMIN_USERNAME=admin
#ADMIN_PASSWORD=
# Klinika parollarini admin qayta ko'ra olishi uchun shifrlash kaliti (ixtiyoriy).
# Berilmasa private/credentials.key da tasodifiy kalit yaratiladi. Kalit almashsa eski parollar ochilmaydi.
#CREDENTIALS_KEY=

# AI yordamchi (Google Gemini). Kalit faqat serverda saqlanadi, ilovaga berilmaydi.
#GEMINI_API_KEY=
# Band bo'lsa keyingisiga o'tadigan modellar (ixtiyoriy):
#GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3-flash-preview
