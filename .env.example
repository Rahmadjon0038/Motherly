# Docker uchun sozlamalar. ./deploy.sh birinchi ishga tushganda bu faylni o'zi yaratadi (.env).

# Bazaning paroli va tokenlar uchun maxfiy kalit (deploy.sh tasodifiy qiymat yozadi)
POSTGRES_PASSWORD=
JWT_SECRET=

# Backend serverga brauzer va telefon qaysi manzil orqali kirishi.
# Serverda ishlatsangiz shu yerga server IP yoki domenini yozing, masalan http://203.0.113.5:5100
PUBLIC_API_URL=http://localhost:5100

# AI yordamchi (Google Gemini). Bo'sh qolsa AI oddiy zaxira javoblar bilan ishlaydi
GEMINI_API_KEY=

# Sinov SMS kodi
DEV_SMS_CODE=1111

# Tashqi portlar (ixtiyoriy)
BACKEND_PORT=5100
WEB_PORT=3000
